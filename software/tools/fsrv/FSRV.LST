# File fsrv.asm
0000			; ============================================================ 
0000			; FSRV.ASM — Bosman-8 CP/M 2.2  File Server  v1.0 
0000			; Assembler:  z80asm -o FSRV.COM fsrv.asm 
0000			; 
0000			; Serwer plikow przez BIOS PUNCH / READER (lacze SIO-B, RS-232). 
0000			; Dziala w petli az do: 
0000			;   - nacisnecia dowolnego klawisza na konsoli (miedzy komendami), 
0000			;   - odebrania komendy 'Q' przez lacze. 
0000			; 
0000			; ---- Protokol binarny (klient -> serwer) -------------------- 
0000			; 
0000			;   GET  'G' + nazwa\0 
0000			;     <- 'K' + rlo + rhi + dane[ (rhi*256+rlo)*128 bajtow ] + crc8 
0000			;     <- 'E' (blad) 
0000			; 
0000			;   PUT  'P' + nazwa\0 + rlo + rhi + dane + crc8 
0000			;     -> 'K'   lub   'E' 
0000			; 
0000			;   DIR  'D' 
0000			;     <- [11 bajtow: 8 nazwy + 3 ext, atrybuty wyciszone]...  + 0x00 
0000			; 
0000			;   QUIT 'Q' 
0000			;     <- 'K'  (serwer konczy prace) 
0000			; 
0000			; CRC8 = XOR kolejnych bajtow danych. 
0000			; Rozmiar pliku podawany w rekordach CP/M (128 B = 1 rekord). 
0000			; 
0000			; Adres bazy BIOS: [0x0001] - 3  (WBOOT = BIOS+3, adres z wektora). 
0000			; Na Bosmanie-8: BIOS w RAM na 0xF200, PUNCH->0xF3EB, READER->0xF3E1. 
0000			; ============================================================ 
0000			 
0000			        org     0x0100 
0100			 
0100			; ---- stale BDOS ---- 
0100			BDOS:   equ     0x0005 
0100			 
0100			; ---- numery funkcji BDOS ---- 
0100			F_WCHR: equ     2 
0100			F_PSTR: equ     9 
0100			F_OPEN: equ     15 
0100			F_CLOS: equ     16 
0100			F_SRCH: equ     17 
0100			F_SNXT: equ     18 
0100			F_DEL:  equ     19 
0100			F_READ: equ     20 
0100			F_WRIT: equ     21 
0100			F_MAKE: equ     22 
0100			F_DMA:  equ     26 
0100			F_FSIZ: equ     35 
0100			 
0100			; ---- przesuniecia BIOS wzgledem bazy BIOS ---- 
0100			B_CONST: equ    6 
0100			B_CONIN: equ    9 
0100			B_PUNCH: equ    18 
0100			B_READR: equ    21 
0100			 
0100			; ---- inne stale ---- 
0100			FCB_LEN: equ    36 
0100			 
0100			; ============================================================ 
0100			; Punkt startowy 
0100			; ============================================================ 
0100			START: 
0100 31 65 05		        ld      sp, STKTOP 
0103			 
0103			        ; Adres bazy BIOS = wektor WBOOT ([0x0001] 2B) - 3 
0103 2a 01 00		        ld      hl, (0x0001) 
0106 2b			        dec     hl 
0107 2b			        dec     hl 
0108 2b			        dec     hl 
0109 22 d9 03		        ld      (BBASE), hl 
010c			 
010c 11 10 04		        ld      de, MBANNER 
010f 0e 09		        ld      c, F_PSTR 
0111 cd 05 00		        call    BDOS 
0114			 
0114			; ============================================================ 
0114			; Glowna petla serwera 
0114			; ============================================================ 
0114			MLOOP: 
0114 11 5a 04		        ld      de, MWAIT 
0117 0e 09		        ld      c, F_PSTR 
0119 cd 05 00		        call    BDOS 
011c			 
011c			        ; Sprawdz konsole (bez blokowania) 
011c cd ac 03		        call    BCONST          ; A=0x00 brak / A=0xFF klawisz 
011f b7			        or      a 
0120 28 0a		        jr      z, MSERIAL 
0122			 
0122			        ; Jest klawisz — odczytaj 
0122 cd b7 03		        call    BCONIN 
0125 e6 df		        and     0xDF 
0127 fe 51		        cp      'Q' 
0129 ca 50 01		        jp      z, MEXIT 
012c			 
012c			MSERIAL: 
012c			        ; Czekaj na komende przez lacze (blokuje) 
012c cd ce 03		        call    BREADR 
012f			 
012f fe 47		        cp      'G' 
0131 ca 5b 01		        jp      z, CMD_GET 
0134 fe 50		        cp      'P' 
0136 ca 16 02		        jp      z, CMD_PUT 
0139 fe 44		        cp      'D' 
013b ca d0 02		        jp      z, CMD_DIR 
013e fe 51		        cp      'Q' 
0140 ca 4b 01		        jp      z, CMD_QUIT 
0143			 
0143			        ; Nieznana komenda 
0143 3e 45		        ld      a, 'E' 
0145 cd c2 03		        call    BPUNCH 
0148 c3 14 01		        jp      MLOOP 
014b			 
014b			; ============================================================ 
014b			; Zakonczenie pracy serwera 
014b			; ============================================================ 
014b			CMD_QUIT: 
014b 3e 4b		        ld      a, 'K' 
014d cd c2 03		        call    BPUNCH 
0150			MEXIT: 
0150 11 8b 04		        ld      de, MBYE 
0153 0e 09		        ld      c, F_PSTR 
0155 cd 05 00		        call    BDOS 
0158 c3 00 00		        jp      0x0000 
015b			 
015b			; ============================================================ 
015b			; CMD_GET — wyslij plik do klienta 
015b			; ============================================================ 
015b			CMD_GET: 
015b 11 69 04		        ld      de, MGET 
015e 0e 09		        ld      c, F_PSTR 
0160 cd 05 00		        call    BDOS 
0163			 
0163 cd 2b 03		        call    RECVFN 
0166			 
0166 cd 53 03		        call    BLDFCB 
0169			 
0169			        ; BDOS fn35: oblicz rozmiar pliku, wynik -> WFCB+33 (lo), WFCB+34 (hi) 
0169 11 ec 03		        ld      de, WFCB 
016c 0e 23		        ld      c, F_FSIZ 
016e cd 05 00		        call    BDOS 
0171 3a 0d 04		        ld      a, (WFCB + 33) 
0174 32 db 03		        ld      (RECLO), a 
0177 3a 0e 04		        ld      a, (WFCB + 34) 
017a 32 dc 03		        ld      (RECHI), a 
017d			 
017d			        ; Przebuduj FCB (fn35 modyfikuje pola extent) 
017d cd 53 03		        call    BLDFCB 
0180			 
0180			        ; Otworz plik 
0180 11 ec 03		        ld      de, WFCB 
0183 0e 0f		        ld      c, F_OPEN 
0185 cd 05 00		        call    BDOS 
0188 fe ff		        cp      0xFF 
018a ca 06 02		        jp      z, GERR 
018d			 
018d			        ; Ustaw DMA -> bufor sektora 
018d 11 a5 04		        ld      de, SBUF 
0190 0e 1a		        ld      c, F_DMA 
0192 cd 05 00		        call    BDOS 
0195			 
0195			        ; Wyslij 'K' + liczba rekordow (2B little-endian) 
0195 3e 4b		        ld      a, 'K' 
0197 cd c2 03		        call    BPUNCH 
019a 3a db 03		        ld      a, (RECLO) 
019d cd c2 03		        call    BPUNCH 
01a0 3a dc 03		        ld      a, (RECHI) 
01a3 cd c2 03		        call    BPUNCH 
01a6			 
01a6			        ; Inicjuj CRC 
01a6 af			        xor     a 
01a7 32 dd 03		        ld      (CRC), a 
01aa			 
01aa			        ; HL = liczba rekordow 
01aa 3a db 03		        ld      a, (RECLO) 
01ad 6f			        ld      l, a 
01ae 3a dc 03		        ld      a, (RECHI) 
01b1 67			        ld      h, a 
01b2			 
01b2			GLOOP: 
01b2 7c			        ld      a, h 
01b3 b5			        or      l 
01b4 28 2d		        jr      z, GDONE 
01b6			 
01b6			        ; Czytaj jeden rekord 128B z dysku 
01b6 e5			        push    hl 
01b7 11 ec 03		        ld      de, WFCB 
01ba 0e 14		        ld      c, F_READ 
01bc cd 05 00		        call    BDOS 
01bf e1			        pop     hl 
01c0 b7			        or      a 
01c1 c2 fc 01		        jp      nz, GERR2 
01c4			 
01c4			        ; Wyslij 128B przez lacze, aktualizuj CRC = CRC ^ bajt 
01c4 e5			        push    hl 
01c5 21 a5 04		        ld      hl, SBUF 
01c8 06 80		        ld      b, 128 
01ca 3a dd 03		        ld      a, (CRC) 
01cd			GSEND: 
01cd 5e			        ld      e, (hl) 
01ce 23			        inc     hl 
01cf ab			        xor     e 
01d0 f5			        push    af 
01d1 e5			        push    hl 
01d2 c5			        push    bc 
01d3 7b			        ld      a, e 
01d4 cd c2 03		        call    BPUNCH 
01d7 c1			        pop     bc 
01d8 e1			        pop     hl 
01d9 f1			        pop     af 
01da 10 f1		        djnz    GSEND 
01dc 32 dd 03		        ld      (CRC), a 
01df e1			        pop     hl 
01e0			 
01e0 2b			        dec     hl 
01e1 18 cf		        jr      GLOOP 
01e3			 
