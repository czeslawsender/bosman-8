03ab			; ============================================================ 
03ab			; Wywolania BIOS przez tablice wektorow w RAM 
03ab			; 
03ab			; Technika: CALL BJMP z HL = adres funkcji BIOS. 
03ab			;   CALL BJMP: odkłada adres powrotu, skacze do BJMP. 
03ab			;   BJMP: JP (HL) -> skacze do BIOS bez modyfikacji stosu. 
03ab			;   BIOS: RET -> wraca do miejsca za CALL BJMP. 
03ab			; ============================================================ 
03ab			BJMP: 
03ab e9			        jp      (hl) 
03ac			 
03ac			BCONST: 
03ac 2a d9 03		        ld      hl, (BBASE) 
03af 11 06 00		        ld      de, B_CONST 
03b2 19			        add     hl, de 
03b3 cd ab 03		        call    BJMP 
03b6 c9			        ret 
03b7			 
03b7			BCONIN: 
03b7 2a d9 03		        ld      hl, (BBASE) 
03ba 11 09 00		        ld      de, B_CONIN 
03bd 19			        add     hl, de 
03be cd ab 03		        call    BJMP 
03c1 c9			        ret 
03c2			 
03c2			BPUNCH: 
03c2			        ; BIOS PUNCH oczekuje bajtu w rejestrze C 
03c2 4f			        ld      c, a 
03c3 2a d9 03		        ld      hl, (BBASE) 
03c6 11 12 00		        ld      de, B_PUNCH 
03c9 19			        add     hl, de 
03ca cd ab 03		        call    BJMP 
03cd c9			        ret 
03ce			 
03ce			BREADR: 
03ce 2a d9 03		        ld      hl, (BBASE) 
03d1 11 15 00		        ld      de, B_READR 
03d4 19			        add     hl, de 
03d5 cd ab 03		        call    BJMP 
03d8 c9			        ret 
