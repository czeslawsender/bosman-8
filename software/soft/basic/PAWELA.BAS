99 'inicjalizacja
100 CLEAR
110 LET PKT=O
120 LET XEKRANU=39
130 LET YEKRANU=24
140 LET XOKR=XEKRANU/2-3
149  ' petla glowa - 10 skoczkow
150  FOR SPAD=1 TO 10
160  LET XSPAD=INT(RND(1)*(XEKRANU-5))
169   ' petla - 1 skok
170   FOR YSPAD=2 TO YEKRANU-5
180   LOCATE 1,1
190   PRINT "                   ";P KT;"pkt."
200    FOR Y=1 TO YSPAD
210    PRINT
220    NEXT Y
230  LET XSPAD=XSPAD+.5-INT(RND(1)*4)/2
240   IF XPAD<O THEN LET XPAD=O
250  IF XSPAD>XEKRANU-5 THEN LET XSPAD=XEKRANU-5
260   GOSUB 1000
270   PRINT "   "
280   GOSUB 1000
290   PRINT "( )"
300   GOSUB 1000
310   PRINT " , "
320    FOR Y=YSPAD+5 TO YEKRANU-1
330    PRINT
340    NEXT Y
350   LET K$=INKEY$
360   IF  K$="z" THEN LET XOKR=XOKR-1
370   IF  K$="x" THEN LET XOKR=XOKR+1
380   IF  XOKR<O THEN LET XOKR=O
390   IF XOKR>XEKRANU-7 THEN LET XOKR=XE KRANU-7
400    FOR X=1 TO XOKR
410    PRINT " ";
420    NEXT X
430   PRINT " \__/ "
440   NEXT YSPAD
450  IF XSPAD>=XOKR AND XSPAD<XOKR+4 THEN GOSUB 2000
460 CLEAR
470  NEXT SPAD
480 PRINT "Zdobyles ";PKT;"pkt."
490 INPUT "Grasz jeszcze raz (t/n)";ODP$
500 IF ODP$="t" THEN GOTO 100
510 END
